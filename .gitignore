# Dependencies and build output
node_modules/
.pnpm-store/

# Tool scratch dirs (office previews etc.)
.dsh-office-*/

# Local config and ledger -- never versioned
.dsh/
ledger*.jsonl
config.json
runtime.json

# Docs build scratch -- the script itself IS versioned (docs/build_doc.py),
# because losing it means rewriting the whole tech doc generator from scratch.
docs/*.tmp.*
docs/~$*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs and temp
*.log
*.tmp
*.bak
